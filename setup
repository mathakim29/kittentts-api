#!/usr/bin/env python3
import argparse
import os
import subprocess
import sys

def main():
    parser = argparse.ArgumentParser(description="Manage kitten-tts Docker container")
    parser.add_argument("action", choices=["build", "run"], help="Action to perform")
    parser.add_argument("--port", "-p", type=int, default=8000, help="Port to expose (default: 8000)")
    args = parser.parse_args()

    pwd = os.getcwd()

    if args.action == "build":
        cmd = ["docker", "build", "-t", "kitten-tts", "-f", "dockerfile", "."]
    elif args.action == "run":
        cmd = [
            "docker", "run", "-it", "--rm",
            "--name", "kitten-tts",
            "-p", f"{args.port}:8000",
            "-v", "/tmp/kitten-tts/models:/root/.cache/huggingface",
            "-v", f"{pwd}/src:/app",
            "--gpus", "all",
            "kitten-tts",
            "bash", "run"
        ]

    try:
        subprocess.run(cmd, check=True)
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)

if __name__ == "__main__":
    main()